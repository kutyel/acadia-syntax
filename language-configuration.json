{
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "{-",
      "-}"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{-",
      "close": "-}"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "(-?\\d*\\.\\d+)|([^`~!@#$%^&*()=+\\[\\]{}\\\\|;:\\\",.<>/?\\s]+)",
  "indentationRules": {
    "increaseIndentPattern": "^((?!.*--).)*(\\b(let|of|then|else)\\b\\s*$|=\\s*$|:=\\s*$|\\{[^}]*$|\\[[^\\]]*$|\\([^)]*$)",
    "decreaseIndentPattern": "^\\s*(in\\b|\\}|\\]|\\))"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\{-[^}]*$",
      "afterText": "^\\s*-\\}",
      "action": {
        "indentAction": "indentOutdent",
        "appendText": " "
      }
    },
    {
      "beforeText": "^\\s*--.*$",
      "action": {
        "indentAction": "none",
        "appendText": "-- "
      }
    }
  ]
}
